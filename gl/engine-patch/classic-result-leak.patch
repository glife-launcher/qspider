diff --git a/qsp/variables.h b/qsp/variables.h
index 8caeb0d..24acb0b 100644
--- a/qsp/variables.h
+++ b/qsp/variables.h
@@ -167,14 +167,32 @@
     INLINE int qspAllocateSavedVarsGroupWithArgs(QSPVar *varArgs, QSPVar *varRes)
     {
         QSPVar *varsList;
+        int varsCount;
         int groupInd = qspAllocateSavedVarsGroup();
-        varsList = (QSPVar *)malloc(2 * sizeof(QSPVar)); /* ARGS & RESULT */
+        /* Classic QSP 5.8 compatibility patch: ARGS is always call-local, but
+         * RESULT is call-local ONLY when the call expects a return value
+         * (FUNC / DYNEVAL - callers pass varRes then). For GOSUB and plain
+         * DYNAMIC (varRes == NULL) RESULT behaves like a global variable, as in
+         * classic 5.8: a value assigned inside the callee stays visible to the
+         * caller after the call returns. Games written for the classic player
+         * (e.g. Girl Life) rely on both halves: jobs.qsrc's is_arrival_time is
+         * a FUNC whose callee sets RESULT via an inner GS (needs the GS leak
+         * within the FUNC frame), while stat_display_menu.qsrc accumulates
+         * HTML into $RESULT across nested FUNC row builders (needs FUNC calls
+         * to save/restore the caller's accumulator, or rows duplicate).
+         * FUNC's return value still works: the call site reads the callee's
+         * RESULT via qspApplyResult before the restore. */
+        varsCount = (varRes ? 2 : 1);
+        varsList = (QSPVar *)malloc(varsCount * sizeof(QSPVar)); /* ARGS (+ RESULT for FUNC/DYNEVAL) */
         varsList[0].Name = qspCopyToNewText(varArgs->Name);
         qspMoveVar(&varsList[0], varArgs);
-        varsList[1].Name = qspCopyToNewText(varRes->Name);
-        qspMoveVar(&varsList[1], varRes);
+        if (varRes)
+        {
+            varsList[1].Name = qspCopyToNewText(varRes->Name);
+            qspMoveVar(&varsList[1], varRes);
+        }
         qspSavedVarGroups[groupInd].Vars = varsList;
-        qspSavedVarGroups[groupInd].VarsCount = 2;
+        qspSavedVarGroups[groupInd].VarsCount = varsCount;
         return groupInd;
     }
 
